#!/usr/bin/env bash
# claude-worker
#
# Run one pstack worker seat as a headless Claude Code process on the worker
# model provider (claude/worker/provider.env).
#
# The coordinator session runs Opus on the Claude Pro plan. Claude Code
# subagents can only use that plan, so a pstack role whose value is
# worker/<alias> runs here instead: `claude -p` with CLAUDE_CONFIG_DIR set to
# the separate worker profile (~/.claude-worker). That profile reaches the
# provider through its settings.json (ANTHROPIC_BASE_URL plus the
# claude-worker-key apiKeyHelper), so the worker never reads or uses the Pro login.
#
# Usage:
#   claude-worker run --model worker/<alias> --dir <path> --brief <file> --report <file>
#                     [--readonly] [--max-turns N] [--timeout SECONDS]
#   claude-worker models
#   claude-worker doctor [--live]
#   claude-worker usage
#
# Exit status: 0 success, 1 worker run failed, 2 usage error,
#              3 worker profile, provider API key, or required isolation not configured.
#
# Write-seat isolation (CLAUDE_WORKER_ISOLATION): auto (default) runs each
# write seat in its own Docker Sandboxes microVM (sbx, clone mode) when sbx
# works on this host, else on the host with a warning; sbx requires the
# microVM (exit 3 without it); none always runs on the host.
set -Eeuo pipefail

script_path="$(readlink -f -- "${BASH_SOURCE[0]}" 2>/dev/null || python3 -c 'import os,sys; print(os.path.realpath(sys.argv[1]))' "${BASH_SOURCE[0]}")"
REPO_DIR="$(cd -- "$(dirname -- "$script_path")/.." && pwd)"
HELPER="$REPO_DIR/lib/agent_stack.py"
ROSTER="${CLAUDE_WORKER_ROSTER:-$REPO_DIR/claude/worker/models.tsv}"
PROVIDER_FILE="${CLAUDE_WORKER_PROVIDER_FILE:-$REPO_DIR/claude/worker/provider.env}"
WORKER_CONFIG_DIR="${CLAUDE_WORKER_CONFIG_DIR:-$HOME/.claude-worker}"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/claude-worker"
LEDGER="$STATE_DIR/runs.tsv"
KEY_HELPER="$REPO_DIR/bin/claude-worker-key"
CLAUDE_MIN_VERSION="2.1.259"
DEFAULT_MAX_TURNS=80
DEFAULT_TIMEOUT=3600
# A read-only seat keeps Bash, as the pstack Claude Code adapter maps
# readonly to the Explore subagent. It has no edit tools, and its Bash runs
# in the Claude Code sandbox (see readonly_sandbox_settings).
READONLY_TOOLS="Read,Glob,Grep,Bash"
WRITE_TOOLS="Read,Edit,Write,Glob,Grep,Bash"
DISALLOWED_TOOLS="Agent,WebSearch"
# Docker Sandboxes (https://docs.docker.com/ai/sandboxes/) for write seats.
ISOLATION_SETTING="${CLAUDE_WORKER_ISOLATION:-auto}"
SBX_BIN="${CLAUDE_WORKER_SBX_BIN:-sbx}"
SBX_CPUS="${CLAUDE_WORKER_SBX_CPUS:-2}"
SBX_MEMORY="${CLAUDE_WORKER_SBX_MEMORY:-4g}"
# Clone mode mounts the host repository read-only at this path in the sandbox.
SBX_SOURCE="${CLAUDE_WORKER_SBX_SOURCE:-/run/sandbox/source}"
SBX_RESULT_BRANCH="claude-worker-result"
SBX_AUTOCOMMIT_MARKER="[claude-worker-autocommit]"

usage() {
  sed -n '14,28p' "$script_path" | sed 's/^# \{0,1\}//' >&2
}

fail_usage() {
  printf 'claude-worker: %s\n' "$*" >&2
  usage
  exit 2
}

fail_config() {
  printf 'claude-worker: %s\n' "$*" >&2
  exit 3
}

provider_setting() {
  python3 "$HELPER" env-value "$PROVIDER_FILE" "$1" 2>/dev/null
}

claude_binary() {
  if [[ -n "${CLAUDE_WORKER_CLAUDE_BIN:-}" ]]; then
    printf '%s\n' "$CLAUDE_WORKER_CLAUDE_BIN"
    return 0
  fi
  # type -P ignores shell functions, so the interactive `claude` wrapper (which
  # starts an ai-memory workstream) is never used for a worker.
  type -P claude || return 1
}

# Print "<model_id>\t<family>" for an alias, with or without the worker/ prefix.
resolve_alias() {
  local requested="${1#worker/}"
  python3 - "$ROSTER" "$requested" <<'PY'
import sys
from pathlib import Path

roster, requested = Path(sys.argv[1]), sys.argv[2]
for line in roster.read_text(encoding="utf-8").splitlines():
    if not line.strip() or line.startswith("#"):
        continue
    fields = line.split("\t")
    if len(fields) != 4:
        raise SystemExit(f"Invalid roster row in {roster}: {line!r}")
    alias, model_id, family, _allowance = fields
    if alias == requested:
        print(f"{model_id}\t{family}")
        raise SystemExit(0)
raise SystemExit(1)
PY
}

require_profile() {
  local settings="$WORKER_CONFIG_DIR/settings.json"
  [[ -f "$settings" ]] || \
    fail_config "worker profile is missing: $settings. Run apply.sh from guisaliba/agents."
  python3 - "$settings" <<'PY' || fail_config "worker profile $settings has no apiKeyHelper or ANTHROPIC_BASE_URL. Run apply.sh from guisaliba/agents."
import json
import sys

data = json.load(open(sys.argv[1], encoding="utf-8"))
ok = isinstance(data, dict) and data.get("apiKeyHelper") and \
    isinstance(data.get("env"), dict) and data["env"].get("ANTHROPIC_BASE_URL")
raise SystemExit(0 if ok else 1)
PY
}

require_key() {
  "$KEY_HELPER" >/dev/null 2>&1 || \
    fail_config "the worker provider API key is not available. Run claude-worker-key to see why."
}

# A writing seat owns one linked Git worktree (the pstack
# separate-before-serializing-shared-state principle). The worktree name is
# free; the isolation is what counts. Refuse the main working tree, a
# directory outside Git, and a worktree where another write seat runs.
require_write_worktree() {
  local dir="$1" git_dir common_dir
  git_dir="$(git -C "$dir" rev-parse --path-format=absolute --git-dir 2>/dev/null)" || \
    fail_usage "a write seat needs --dir inside a linked Git worktree; $dir is not in a Git worktree"
  common_dir="$(git -C "$dir" rev-parse --path-format=absolute --git-common-dir)"
  [[ "$git_dir" != "$common_dir" ]] || \
    fail_usage "a write seat needs its own linked worktree, not the main working tree ($dir). Create one: git worktree add <repository>-worktrees/<role>-<n> <base-ref>"
  WRITE_LOCK="$git_dir/claude-worker.lock"
}

# mkdir is atomic, so one seat wins the lock. A lock whose pid file names a
# process that no longer runs is stale (a killed run) and is replaced. An
# empty pid file counts as busy: its owner is between mkdir and the write.
acquire_write_lock() {
  local owner
  if ! mkdir -- "$WRITE_LOCK" 2>/dev/null; then
    owner="$(cat -- "$WRITE_LOCK/pid" 2>/dev/null || true)"
    if [[ ! "$owner" =~ ^[0-9]+$ ]] || kill -0 "$owner" 2>/dev/null; then
      fail_usage "another write seat (pid ${owner:-unknown}) runs in this worktree ($WRITE_LOCK)"
    fi
    rm -rf -- "$WRITE_LOCK"
    mkdir -- "$WRITE_LOCK" 2>/dev/null || \
      fail_usage "another write seat took the lock first ($WRITE_LOCK)"
  fi
  printf '%s\n' "$$" >"$WRITE_LOCK/pid"
  WRITE_LOCK_HELD=true
}

# EXIT trap of a run: remove the sandbox (unless kept) and release the lock.
run_cleanup() {
  sbx_cleanup
  [[ "${WRITE_LOCK_HELD:-false}" != true ]] || rm -rf -- "$WRITE_LOCK"
}

# A read-only seat keeps Bash, so the Claude Code sandbox (bubblewrap on
# Linux, Seatbelt on macOS) is what keeps it read-only: every Bash command
# runs with the checkout and its Git directory write-denied. The sandbox
# fails closed: claude refuses to start when it cannot build one. Its Linux
# dependencies are checked here first, so a missing package is a
# configuration error (exit 3), not a seat dropout (exit 1).
sandbox_commands() {
  if [[ -n "${CLAUDE_WORKER_SANDBOX_COMMANDS+set}" ]]; then
    printf '%s\n' "$CLAUDE_WORKER_SANDBOX_COMMANDS"
    return 0
  fi
  case "$(uname -s)" in
    Linux) printf 'bwrap socat\n' ;;
    *) printf '\n' ;;
  esac
}

missing_sandbox_commands() {
  local command_name
  local -a missing=()
  for command_name in $(sandbox_commands); do
    type -P "$command_name" >/dev/null 2>&1 || missing+=("$command_name")
  done
  printf '%s' "${missing[*]}"
}

require_sandbox() {
  local missing
  missing="$(missing_sandbox_commands)"
  [[ -z "$missing" ]] || \
    fail_config "a read-only seat needs the Claude Code sandbox, which needs: $missing. Install bubblewrap and socat (Arch: sudo pacman -S bubblewrap socat)."
}

# Print the --settings JSON for a read-only seat. The deny list holds the
# worktree top level and the shared Git directory, so neither the files nor
# the refs, index, or stash change, also from a linked worktree. Bash in the
# seat can write only to $TMPDIR and has no network.
readonly_sandbox_settings() {
  local dir="$1" top="" common=""
  if top="$(git -C "$dir" rev-parse --show-toplevel 2>/dev/null)"; then
    common="$(git -C "$dir" rev-parse --path-format=absolute --git-common-dir)"
  else
    top="$(cd -- "$dir" && pwd -P)"
  fi
  python3 - "$top" "$common" <<'PY'
import json
import sys

import os

deny = [os.path.realpath(path) for path in sys.argv[1:] if path]
# Hooks and MCP servers run outside the sandbox, so a read-only seat has
# neither: disableAllHooks here, --strict-mcp-config on the command line.
print(json.dumps({"disableAllHooks": True, "sandbox": {
    "enabled": True,
    "failIfUnavailable": True,
    "allowUnsandboxedCommands": False,
    "autoAllowBashIfSandboxed": True,
    "filesystem": {"denyWrite": deny},
}}))
PY
}

# --- Write-seat isolation in Docker Sandboxes --------------------------------
#
# A write seat in a microVM (https://docs.docker.com/ai/sandboxes/workflows/git/):
#   1. sbx create --clone from the main checkout (clone mode refuses a linked
#      worktree). The host repository is read-only at $SBX_SOURCE inside.
#   2. The clone checks out the HEAD commit of the seat's linked worktree,
#      fetched from $SBX_SOURCE, so the seat starts where the worktree is.
#   3. claude -p runs in the clone, with the provider settings and key passed
#      for this one command. The host ~/.claude-worker is not in the sandbox.
#   4. Uncommitted edits become one marked commit. The host fetches the result
#      from the sandbox-<name> remote and fast-forwards the worktree, then
#      undoes the marked commit, so the worktree holds the same commits and
#      uncommitted edits that a host run leaves.
#   5. sbx rm. A failed fetch keeps the sandbox for inspection.

# Print why sbx cannot run write seats on this host, or nothing when it can.
sbx_unavailable_reason() {
  if ! type -P "$SBX_BIN" >/dev/null 2>&1; then
    printf 'the sbx CLI is not installed (see https://docs.docker.com/ai/sandboxes/install/)'
    return 0
  fi
  if ! "$SBX_BIN" ls >/dev/null 2>&1; then
    printf 'sbx ls failed: the sbx daemon does not run, you are not signed in (sbx login), or this host has no hardware virtualization (KVM)'
    return 0
  fi
}

# Set ISOLATION to sbx or none for a write seat, from CLAUDE_WORKER_ISOLATION.
select_write_isolation() {
  local reason
  case "$ISOLATION_SETTING" in
    none) ISOLATION=none ;;
    sbx|auto)
      reason="$(sbx_unavailable_reason)"
      if [[ -z "$reason" ]]; then
        ISOLATION=sbx
      elif [[ "$ISOLATION_SETTING" == sbx ]]; then
        fail_config "CLAUDE_WORKER_ISOLATION=sbx, but $reason"
      else
        ISOLATION=none
        printf 'claude-worker: warning: isolation none: %s. This write seat runs on the host without a microVM.\n' "$reason" >&2
      fi
      ;;
    *) fail_usage "CLAUDE_WORKER_ISOLATION must be auto, sbx, or none, not: $ISOLATION_SETTING" ;;
  esac
}

# Clone mode copies only commits, so a write seat in a sandbox needs a clean
# worktree: the coordinator commits the changes it copies into the worktree.
require_clean_worktree() {
  local dir="$1"
  [[ -z "$(git -C "$dir" status --porcelain --untracked-files=normal)" ]] || \
    fail_usage "a write seat in a sandbox needs a clean worktree, because clone mode copies only commits. Commit the changes in $dir first, or set CLAUDE_WORKER_ISOLATION=none."
}

# Print the main working tree of the repository that holds $1.
main_worktree() {
  git -C "$1" worktree list --porcelain | sed -n '1s/^worktree //p'
}

# Print KEY=VALUE lines for the worker inside a sandbox: the env block of the
# host worker profile (base URL, background model, beta switches), a private
# config directory, and the key for the in-sandbox apiKeyHelper. The file is
# passed with --env-file, so the key is not in argv.
sbx_worker_env_file() {
  local target="$1" key
  key="$("$KEY_HELPER" 2>/dev/null)" || fail_config "the worker provider API key is not available. Run claude-worker-key to see why."
  ( umask 077
    python3 - "$WORKER_CONFIG_DIR/settings.json" >"$target" <<'PY'
import json
import sys

env = json.load(open(sys.argv[1], encoding="utf-8")).get("env", {})
for name, value in env.items():
    value = str(value)
    if "\n" in value:
        raise SystemExit(f"multi-line value for {name} in worker settings")
    print(f"{name}={value}")
print("CLAUDE_CONFIG_DIR=/tmp/claude-worker-profile")
PY
    printf 'CLAUDE_WORKER_KEY=%s\n' "$key" >>"$target"
  )
  unset key
}

# Print the host name of the provider base URL, for the sandbox network rule.
provider_host() {
  python3 -c 'import sys, urllib.parse; print(urllib.parse.urlsplit(sys.argv[1]).hostname or "")' \
    "$(provider_setting WORKER_ANTHROPIC_BASE_URL)"
}

sbx_quiet() {
  "$SBX_BIN" "$@" >>"$SBX_LOG" 2>&1
}

# Remove the sandbox unless SBX_KEEP is set. Runs from the EXIT trap.
sbx_cleanup() {
  [[ -n "${SBX_ENV_FILE:-}" ]] && rm -f -- "$SBX_ENV_FILE"
  [[ -n "${SBX_NAME:-}" ]] || return 0
  if [[ "${SBX_KEEP:-false}" == true ]]; then
    printf 'claude-worker: sandbox %s kept for inspection: sbx exec -it %s bash; remove it with sbx rm --force %s\n' \
      "$SBX_NAME" "$SBX_NAME" "$SBX_NAME" >&2
  else
    sbx_quiet rm --force "$SBX_NAME" || true
  fi
}

# Create the sandbox and put the clone at the worktree HEAD. Sets SBX_NAME
# and SBX_CLONE. Returns non-zero when a step fails (see $SBX_LOG).
sbx_prepare() {
  local dir="$1" base="$2" main host
  main="$(main_worktree "$dir")"
  SBX_NAME="cw-$(date +%s)-$$-$RANDOM"
  sbx_quiet create --clone --name "$SBX_NAME" --pull missing --no-progress \
    --cpus "$SBX_CPUS" --memory "$SBX_MEMORY" claude "$main" || return 1
  host="$(provider_host)"
  [[ -z "$host" ]] || sbx_quiet policy allow network "$SBX_NAME" "$host" || return 1
  SBX_CLONE="$("$SBX_BIN" exec "$SBX_NAME" pwd 2>>"$SBX_LOG")" || return 1
  [[ -n "$SBX_CLONE" ]] || return 1
  sbx_quiet exec -w "$SBX_CLONE" "$SBX_NAME" \
    git -c safe.directory='*' fetch --quiet --no-tags "$SBX_SOURCE" "$base" || return 1
  sbx_quiet exec -w "$SBX_CLONE" "$SBX_NAME" git checkout --quiet -B claude-worker-seat "$base"
}

# Commit leftover edits in the clone, fetch the result into the worktree,
# fast-forward it, and undo the marked commit. Returns non-zero on failure.
sbx_collect() {
  local dir="$1" base="$2" fetched
  sbx_quiet exec -w "$SBX_CLONE" "$SBX_NAME" bash -c '
    git add -A &&
    { git diff --cached --quiet ||
      git -c user.name=claude-worker -c user.email=claude-worker@localhost \
        commit --quiet --no-verify -m "claude-worker: uncommitted edits $1"; } &&
    git branch --force "$2" HEAD' _ "$SBX_AUTOCOMMIT_MARKER" "$SBX_RESULT_BRANCH" || return 1
  git -C "$dir" fetch --quiet --no-tags "sandbox-$SBX_NAME" "$SBX_RESULT_BRANCH" >>"$SBX_LOG" 2>&1 || return 1
  fetched="$(git -C "$dir" rev-parse FETCH_HEAD)"
  if ! git -C "$dir" merge-base --is-ancestor "$base" "$fetched"; then
    printf 'claude-worker: the sandbox result %s does not descend from the seat base %s\n' "$fetched" "$base" >>"$SBX_LOG"
    return 1
  fi
  git -C "$dir" merge --quiet --ff-only "$fetched" >>"$SBX_LOG" 2>&1 || return 1
  if [[ "$fetched" != "$base" ]] && \
    [[ "$(git -C "$dir" log -1 --format=%s HEAD)" == *"$SBX_AUTOCOMMIT_MARKER" ]]; then
    git -C "$dir" reset --quiet --mixed HEAD~1 >>"$SBX_LOG" 2>&1 || return 1
  fi
}

# Run one write seat in a new sandbox. Arguments: worktree, brief text,
# timeout, raw output file, stderr file, report path, then the claude
# arguments. Returns the worker status, or 1 when the sandbox fails.
run_in_sandbox() {
  local dir="$1" brief_text="$2" timeout_seconds="$3" raw="$4" errors="$5" report="$6"
  shift 6
  local base status=0
  base="$(git -C "$dir" rev-parse HEAD)"
  SBX_LOG="$report.sbx.log"
  : >"$SBX_LOG"
  : >"$raw"
  SBX_ENV_FILE="$(mktemp)"
  sbx_worker_env_file "$SBX_ENV_FILE"
  if ! sbx_prepare "$dir" "$base"; then
    printf 'claude-worker: could not prepare sandbox %s. See %s.\n' "${SBX_NAME:-}" "$SBX_LOG" >"$errors"
    return 1
  fi
  # The host profile (~/.claude-worker) is not in the sandbox, so the
  # contract goes in as an appended system prompt and the key through an
  # apiKeyHelper that reads the variable from the env file.
  local -a command=(claude "$@"
    --settings '{"apiKeyHelper": "printenv CLAUDE_WORKER_KEY"}'
    --append-system-prompt "$(cat -- "$REPO_DIR/claude/worker/contract.md")")
  python3 "$HELPER" run-with-deadline "$timeout_seconds" \
    "$SBX_BIN" exec -i -w "$SBX_CLONE" --env-file "$SBX_ENV_FILE" "$SBX_NAME" "${command[@]}" \
    <<<"$brief_text" >"$raw" 2>"$errors" || status=$?
  rm -f -- "$SBX_ENV_FILE"
  if ! sbx_collect "$dir" "$base"; then
    SBX_KEEP=true
    printf 'claude-worker: could not bring the result of sandbox %s back to %s. See %s.\n' \
      "$SBX_NAME" "$dir" "$SBX_LOG" >>"$errors"
    [[ "$status" -ne 0 ]] || status=1
  fi
  return "$status"
}

# The worker gets a small, explicit environment. This keeps the coordinator's
# session variables (CLAUDECODE, ANTHROPIC_*, the Pro OAuth state) out of the
# worker, so the worker cannot fall back to the Pro plan or detect nesting.
worker_environment() {
  local name
  local -a pass=(HOME USER LOGNAME PATH SHELL LANG LC_ALL LC_CTYPE TERM TMPDIR
    XDG_CONFIG_HOME XDG_DATA_HOME XDG_STATE_HOME XDG_CACHE_HOME XDG_RUNTIME_DIR
    CLAUDE_WORKER_KEY_ENV_FILE CLAUDE_WORKER_PROVIDER_FILE
    # Outbound network path. A network secret (cloud/README.md) is injected only
    # into requests that go through the egress proxy, so without these the
    # provider answers 401 and Claude Code retries until the run deadline.
    HTTPS_PROXY https_proxy HTTP_PROXY http_proxy ALL_PROXY all_proxy NO_PROXY no_proxy
    NODE_EXTRA_CA_CERTS SSL_CERT_FILE SSL_CERT_DIR)
  WORKER_ENV=()
  for name in "${pass[@]}"; do
    if [[ -n "${!name:-}" ]]; then
      WORKER_ENV+=("$name=${!name}")
    fi
  done
  # The apiKeyHelper (claude-worker-key) runs inside the worker. The two
  # CLAUDE_WORKER_*_FILE paths and the worker profile path (for the
  # network-secret marker) go with it, so it finds the same key source as the
  # preflight require_key. They are paths. The key variable itself passes
  # only when it is already in this environment (a cloud environment
  # variable), where every process of the session can read it anyway.
  local key_variable
  key_variable="$(provider_setting WORKER_API_KEY_VARIABLE || true)"
  if [[ -n "$key_variable" && -n "${!key_variable:-}" ]]; then
    WORKER_ENV+=("$key_variable=${!key_variable}")
  fi
  WORKER_ENV+=("CLAUDE_WORKER_CONFIG_DIR=$WORKER_CONFIG_DIR" "CLAUDE_CONFIG_DIR=$WORKER_CONFIG_DIR")
}

command_run() {
  trap run_cleanup EXIT
  local alias="" dir="" brief="" report="" readonly=false
  local max_turns="$DEFAULT_MAX_TURNS" timeout_seconds="$DEFAULT_TIMEOUT"
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --model) alias="${2:-}"; shift 2 ;;
      --dir) dir="${2:-}"; shift 2 ;;
      --brief) brief="${2:-}"; shift 2 ;;
      --report) report="${2:-}"; shift 2 ;;
      --readonly) readonly=true; shift ;;
      --max-turns) max_turns="${2:-}"; shift 2 ;;
      --timeout) timeout_seconds="${2:-}"; shift 2 ;;
      *) fail_usage "unknown option for run: $1" ;;
    esac
  done

  [[ -n "$alias" && -n "$dir" && -n "$brief" && -n "$report" ]] || \
    fail_usage "run needs --model, --dir, --brief, and --report"
  [[ "$max_turns" =~ ^[1-9][0-9]*$ ]] || fail_usage "--max-turns must be a positive integer"
  [[ "$timeout_seconds" =~ ^[1-9][0-9]*$ ]] || fail_usage "--timeout must be a positive integer"
  [[ -d "$dir" ]] || fail_usage "--dir is not a directory: $dir"
  # Read the brief once, so a pipe such as <(...) works as well as a file.
  local brief_text=""
  [[ -r "$brief" ]] && brief_text="$(cat -- "$brief")"
  [[ -n "${brief_text//[[:space:]]/}" ]] || fail_usage "--brief is missing or empty: $brief"
  [[ -d "$(dirname -- "$report")" ]] || fail_usage "--report directory does not exist: $(dirname -- "$report")"
  # The worker runs in --dir, so a relative report path must not be read
  # from one directory and written from another.
  report="$(cd -- "$(dirname -- "$report")" && pwd -P)/$(basename -- "$report")"

  [[ "$readonly" == true ]] || require_write_worktree "$dir"

  local resolved model_id family
  resolved="$(resolve_alias "$alias")" || \
    fail_usage "unknown worker alias: $alias. Run: claude-worker models"
  IFS=$'\t' read -r model_id family <<<"$resolved"

  require_profile
  require_key

  local claude
  claude="$(claude_binary)" || fail_config "the claude executable is not on PATH"

  local -a arguments=(-p --model "$model_id" --output-format json
    --max-turns "$max_turns" --permission-prompts none
    --disallowedTools "$DISALLOWED_TOOLS")
  local mode sandbox=false
  if [[ "$readonly" == true ]]; then
    mode="readonly"
    require_sandbox
    sandbox=true
    arguments+=(--permission-mode dontAsk --tools "$READONLY_TOOLS"
      --allowedTools "$READONLY_TOOLS" --strict-mcp-config
      --settings "$(readonly_sandbox_settings "$dir")")
  else
    mode="write"
    arguments+=(--permission-mode acceptEdits --allowedTools "$WRITE_TOOLS")
  fi


  ISOLATION="claude-code-sandbox"
  if [[ "$readonly" != true ]]; then
    select_write_isolation
    [[ "$ISOLATION" != sbx ]] || require_clean_worktree "$dir"
    acquire_write_lock
  fi
  local raw="$report.raw.json" errors="$report.stderr.log" started ended status=0
  started="$(date +%s)"
  if [[ "$ISOLATION" == sbx ]]; then
    run_in_sandbox "$dir" "$brief_text" "$timeout_seconds" "$raw" "$errors" "$report" \
      "${arguments[@]}" || status=$?
  else
    worker_environment
    (
      cd -- "$dir"
      env -i "${WORKER_ENV[@]}" python3 "$HELPER" run-with-deadline "$timeout_seconds" \
        "$claude" "${arguments[@]}" <<<"$brief_text" >"$raw" 2>"$errors"
    ) || status=$?
  fi
  ended="$(date +%s)"

  mkdir -p "$STATE_DIR"
  python3 - "$raw" "$report" "$alias" "$model_id" "$family" "$mode" "$sandbox" "$status" \
    "$started" "$ended" "$dir" "$LEDGER" "$ISOLATION" "${SBX_NAME:-}" <<'PY'
import json
import os
import sys
import tempfile
from datetime import datetime, timezone
from pathlib import Path

(raw, report, alias, model_id, family, mode, sandbox, status,
 started, ended, directory, ledger, isolation, sandbox_name) = sys.argv[1:]
status = int(status)
payload = {}
try:
    text = Path(raw).read_text(encoding="utf-8").strip()
    if text:
        payload = json.loads(text.splitlines()[-1])
except (OSError, json.JSONDecodeError):
    payload = {}
if not isinstance(payload, dict):
    payload = {}

result = payload.get("result")
is_error = bool(payload.get("is_error")) if payload else True
usage = payload.get("usage") if isinstance(payload.get("usage"), dict) else {}
succeeded = status == 0 and not is_error and isinstance(result, str) and result.strip() != ""

report_path = Path(report)
if isinstance(result, str) and result.strip():
    report_path.write_text(result.rstrip() + "\n", encoding="utf-8")
else:
    report_path.write_text(
        "**Result**: worker produced no report.\n\n"
        f"Exit status {status}. See {raw} and {report}.stderr.log.\n",
        encoding="utf-8",
    )

meta = {
    "alias": alias,
    "model_id": model_id,
    "family": family,
    "mode": mode,
    "sandbox": sandbox == "true",
    # claude-code-sandbox (read-only seat), sbx (write seat in a Docker
    # Sandboxes microVM), or none (write seat on the host).
    "isolation": isolation,
    "sandbox_name": sandbox_name or None,
    "exit_status": status,
    "succeeded": succeeded,
    "is_error": is_error,
    "duration_seconds": int(ended) - int(started),
    "num_turns": payload.get("num_turns"),
    "usage": usage,
    "session_id": payload.get("session_id"),
    "directory": directory,
}
Path(report + ".meta.json").write_text(json.dumps(meta, indent=2) + "\n", encoding="utf-8")

ledger_path = Path(ledger)
header = "utc\talias\tmodel_id\tmode\tsucceeded\tduration_s\tturns\tinput_tokens\toutput_tokens\tcache_read_tokens\tcache_creation_tokens\tdirectory\n"
# Seats of one panel finish in parallel. Create the ledger with its header
# in one atomic step (os.link fails when the file exists), so exactly one
# header is written. Each row is then one O_APPEND write.
if not ledger_path.exists():
    fd, temporary = tempfile.mkstemp(dir=ledger_path.parent, prefix=".runs.")
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as handle:
            handle.write(header)
        os.link(temporary, ledger_path)
    except FileExistsError:
        pass
    finally:
        os.unlink(temporary)
row = [
    datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"),
    alias, model_id, mode, "yes" if succeeded else "no",
    str(meta["duration_seconds"]), str(meta["num_turns"] or 0),
    str(usage.get("input_tokens", 0)), str(usage.get("output_tokens", 0)),
    str(usage.get("cache_read_input_tokens", 0)),
    str(usage.get("cache_creation_input_tokens", 0)),
    directory.replace("\t", " "),
]
fd = os.open(ledger_path, os.O_WRONLY | os.O_APPEND)
try:
    os.write(fd, ("\t".join(row) + "\n").encode("utf-8"))
finally:
    os.close(fd)

raise SystemExit(0 if succeeded else 1)
PY
}

command_models() {
  printf 'provider: %s\n' "$(provider_setting WORKER_PROVIDER || printf unknown)"
  printf 'ALIAS\tMODEL_ID\tFAMILY\tMONTHLY_ALLOWANCE_USD\n'
  grep -v '^#' "$ROSTER" | grep -v '^[[:space:]]*$' | sed 's/^/worker\//'
}

command_doctor() {
  local live=false failures=0 claude version
  [[ "${1:-}" == "--live" ]] && live=true

  # A check prints one status line on standard output. The output of the
  # checked command stays hidden, because a check must not print the value
  # that it verifies (the provider API key).
  check() {
    if "$@" >/dev/null; then printf 'ok    %s\n' "$DOCTOR_LABEL"; else printf 'FAIL  %s\n' "$DOCTOR_LABEL"; failures=$((failures + 1)); fi
  }

  DOCTOR_LABEL="claude executable on PATH"
  check claude_binary
  if claude="$(claude_binary)"; then
    version="$("$claude" --version 2>/dev/null || true)"
    DOCTOR_LABEL="claude version $version is $CLAUDE_MIN_VERSION or newer"
    check python3 - "$version" "$CLAUDE_MIN_VERSION" <<'PY'
import re
import sys
found = re.search(r"(\d+)\.(\d+)\.(\d+)", sys.argv[1])
need = tuple(map(int, sys.argv[2].split(".")))
raise SystemExit(0 if found and tuple(map(int, found.groups())) >= need else 1)
PY
  fi

  DOCTOR_LABEL="Claude Code sandbox commands for read-only seats ($(sandbox_commands | tr -s ' \n' ' ' | sed 's/ *$//;s/^$/built in/'))"
  check test -z "$(missing_sandbox_commands)"

  # Write-seat isolation. Without sbx, auto is a warning and not a failure:
  # the seat still runs, on the host (CLAUDE_WORKER_ISOLATION=sbx makes it one).
  local isolation_reason=""
  case "$ISOLATION_SETTING" in
    none) printf 'ok    write-seat isolation: none (CLAUDE_WORKER_ISOLATION=none)\n' ;;
    sbx|auto)
      isolation_reason="$(sbx_unavailable_reason)"
      if [[ -z "$isolation_reason" ]]; then
        printf 'ok    write-seat isolation: Docker Sandboxes microVM (sbx)\n'
      elif [[ "$ISOLATION_SETTING" == sbx ]]; then
        printf 'FAIL  write-seat isolation: CLAUDE_WORKER_ISOLATION=sbx, but %s\n' "$isolation_reason"
        failures=$((failures + 1))
      else
        printf 'warn  write-seat isolation: none, because %s\n' "$isolation_reason"
      fi
      ;;
    *) printf 'FAIL  write-seat isolation: CLAUDE_WORKER_ISOLATION must be auto, sbx, or none\n'
       failures=$((failures + 1)) ;;
  esac

  DOCTOR_LABEL="worker profile $WORKER_CONFIG_DIR/settings.json"
  check bash -c '"$0" __profile' "$script_path"
  DOCTOR_LABEL="provider API key available through claude-worker-key (value not shown)"
  # The helper prints the key on standard output and its reason on standard
  # error. Both stay hidden, because the key must never reach the doctor.
  check "$KEY_HELPER" 2>/dev/null

  DOCTOR_LABEL="every roster model id is in the provider model list"
  check models_in_live_list

  if [[ "$live" == true ]]; then
    DOCTOR_LABEL="one live worker run on worker/$(provider_setting WORKER_SMOKE_ALIAS || printf unset)"
    check live_smoke_run
    if [[ "$ISOLATION_SETTING" != none && -z "$isolation_reason" ]]; then
      DOCTOR_LABEL="one live write seat in a Docker Sandboxes microVM, result back in the worktree"
      check live_sandbox_write_run
    fi
  fi

  if [[ "$failures" -gt 0 ]]; then
    printf '%s check(s) failed.\n' "$failures"
    return 1
  fi
  printf 'All checks passed.\n'
}

models_in_live_list() {
  local key listing models_url
  models_url="$(provider_setting WORKER_MODELS_URL)" || return 1
  key="$("$KEY_HELPER" 2>/dev/null)" || return 1
  # The key goes to curl on standard input, so it never appears in argv.
  listing="$(printf 'header = "Authorization: Bearer %s"\n' "$key" | \
    curl --fail --silent --show-error --max-time 30 --config - "$models_url")" || return 1
  unset key
  python3 - "$ROSTER" "$listing" <<'PY'
import json
import sys
from pathlib import Path

listing = json.loads(sys.argv[2])
items = listing.get("data", listing) if isinstance(listing, dict) else listing
live = {item.get("id") for item in items if isinstance(item, dict)}
missing = []
for line in Path(sys.argv[1]).read_text(encoding="utf-8").splitlines():
    if line.strip() and not line.startswith("#"):
        model_id = line.split("\t")[1]
        if model_id not in live:
            missing.append(model_id)
if missing:
    print("  missing ids: " + ", ".join(missing), file=sys.stderr)
    print("  live ids: " + ", ".join(sorted(i for i in live if i)), file=sys.stderr)
    raise SystemExit(1)
PY
}

live_smoke_run() {
  local work smoke_alias
  smoke_alias="$(provider_setting WORKER_SMOKE_ALIAS)" || return 1
  work="$(mktemp -d)" || return 1
  printf '%s\n' 'Reply with the single word READY and nothing else.' >"$work/brief.md"
  if "$script_path" run --model "worker/$smoke_alias" --dir "$work" \
    --brief "$work/brief.md" --report "$work/report.md" --readonly --max-turns 2 --timeout 180 \
    && grep -q 'READY' "$work/report.md"; then
    rm -rf "$work"
    return 0
  fi
  printf '  smoke run artifacts kept in %s\n' "$work" >&2
  return 1
}

# A write seat in a sandbox creates READY.txt in a scratch worktree. Proves
# sandbox creation, the clone sync, the provider key and network rule inside
# the microVM, and the fetch back into the worktree.
live_sandbox_write_run() {
  local work smoke_alias
  smoke_alias="$(provider_setting WORKER_SMOKE_ALIAS)" || return 1
  work="$(mktemp -d)" || return 1
  git -C "$work" init --quiet main &&
    git -C "$work/main" -c user.name=doctor -c user.email=doctor@localhost \
      commit --quiet --allow-empty -m init &&
    git -C "$work/main" worktree add --quiet --detach "$work/seat" || return 1
  printf '%s\n' 'Create a file named READY.txt in the current directory that contains the single word READY. Then reply with the single word READY.' >"$work/brief.md"
  if CLAUDE_WORKER_ISOLATION=sbx "$script_path" run --model "worker/$smoke_alias" --dir "$work/seat" \
    --brief "$work/brief.md" --report "$work/report.md" --max-turns 6 --timeout 600 \
    && grep -q 'READY' "$work/seat/READY.txt" 2>/dev/null; then
    rm -rf "$work"
    return 0
  fi
  printf '  sandbox smoke run artifacts kept in %s\n' "$work" >&2
  return 1
}

command_usage() {
  [[ -f "$LEDGER" ]] || { printf 'No worker runs recorded yet (%s).\n' "$LEDGER"; return 0; }
  python3 - "$LEDGER" <<'PY'
import csv
import sys
from collections import defaultdict

totals = defaultdict(lambda: [0, 0, 0, 0, 0])
with open(sys.argv[1], encoding="utf-8") as handle:
    for row in csv.DictReader(handle, delimiter="\t"):
        entry = totals[row["alias"]]
        entry[0] += 1
        entry[1] += row["succeeded"] != "yes"
        entry[2] += int(row["input_tokens"] or 0)
        entry[3] += int(row["output_tokens"] or 0)
        entry[4] += int(row["cache_read_tokens"] or 0)
print("ALIAS\tRUNS\tFAILED\tINPUT_TOKENS\tOUTPUT_TOKENS\tCACHE_READ_TOKENS")
for alias, (runs, failed, inp, out, cache) in sorted(totals.items()):
    print(f"{alias}\t{runs}\t{failed}\t{inp}\t{out}\t{cache}")
PY
}

case "${1:-}" in
  run) shift; command_run "$@" ;;
  models) command_models ;;
  doctor) shift; command_doctor "$@" ;;
  usage) command_usage ;;
  __profile) (require_profile) ;;
  -h|--help|help) usage; exit 0 ;;
  *) fail_usage "unknown command: ${1:-<none>}" ;;
esac
