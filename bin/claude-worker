#!/usr/bin/env bash
# claude-worker
#
# Run one pstack worker seat as a headless Claude Code process on the worker
# model provider (claude/worker/provider.env).
#
# The coordinator session runs Opus on the Claude Pro plan. Claude Code
# subagents can only use that plan, so a pstack role whose value is
# worker/<alias> runs here instead: `claude -p` with CLAUDE_CONFIG_DIR set to
# the separate worker profile (~/.claude-worker). That profile reaches the
# provider through its settings.json (ANTHROPIC_BASE_URL plus the
# claude-worker-key apiKeyHelper), so the worker never reads or uses the Pro login.
#
# Usage:
#   claude-worker run --model worker/<alias> --dir <path> --brief <file> --report <file>
#                     [--readonly] [--max-turns N] [--timeout SECONDS]
#   claude-worker models
#   claude-worker doctor [--live]
#   claude-worker usage
#
# Exit status: 0 success, 1 worker run failed, 2 usage error,
#              3 worker profile or provider API key not configured.
set -Eeuo pipefail

script_path="$(readlink -f -- "${BASH_SOURCE[0]}" 2>/dev/null || python3 -c 'import os,sys; print(os.path.realpath(sys.argv[1]))' "${BASH_SOURCE[0]}")"
REPO_DIR="$(cd -- "$(dirname -- "$script_path")/.." && pwd)"
HELPER="$REPO_DIR/lib/agent_stack.py"
ROSTER="${CLAUDE_WORKER_ROSTER:-$REPO_DIR/claude/worker/models.tsv}"
PROVIDER_FILE="${CLAUDE_WORKER_PROVIDER_FILE:-$REPO_DIR/claude/worker/provider.env}"
WORKER_CONFIG_DIR="${CLAUDE_WORKER_CONFIG_DIR:-$HOME/.claude-worker}"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/claude-worker"
LEDGER="$STATE_DIR/runs.tsv"
KEY_HELPER="$REPO_DIR/bin/claude-worker-key"
CLAUDE_MIN_VERSION="2.1.259"
DEFAULT_MAX_TURNS=80
DEFAULT_TIMEOUT=3600
READONLY_TOOLS="Read,Glob,Grep,Bash(git diff *),Bash(git log *),Bash(git show *),Bash(git status *),Bash(rg *),Bash(ls *),Bash(wc *)"
WRITE_TOOLS="Read,Edit,Write,Glob,Grep,Bash"
DISALLOWED_TOOLS="Agent,WebSearch"

usage() {
  sed -n '14,22p' "$script_path" | sed 's/^# \{0,1\}//' >&2
}

fail_usage() {
  printf 'claude-worker: %s\n' "$*" >&2
  usage
  exit 2
}

fail_config() {
  printf 'claude-worker: %s\n' "$*" >&2
  exit 3
}

provider_setting() {
  python3 "$HELPER" env-value "$PROVIDER_FILE" "$1" 2>/dev/null
}

claude_binary() {
  if [[ -n "${CLAUDE_WORKER_CLAUDE_BIN:-}" ]]; then
    printf '%s\n' "$CLAUDE_WORKER_CLAUDE_BIN"
    return 0
  fi
  # type -P ignores shell functions, so the interactive `claude` wrapper (which
  # starts an ai-memory workstream) is never used for a worker.
  type -P claude || return 1
}

# Print "<model_id>\t<family>" for an alias, with or without the worker/ prefix.
resolve_alias() {
  local requested="${1#worker/}"
  python3 - "$ROSTER" "$requested" <<'PY'
import sys
from pathlib import Path

roster, requested = Path(sys.argv[1]), sys.argv[2]
for line in roster.read_text(encoding="utf-8").splitlines():
    if not line.strip() or line.startswith("#"):
        continue
    fields = line.split("\t")
    if len(fields) != 4:
        raise SystemExit(f"Invalid roster row in {roster}: {line!r}")
    alias, model_id, family, _allowance = fields
    if alias == requested:
        print(f"{model_id}\t{family}")
        raise SystemExit(0)
raise SystemExit(1)
PY
}

require_profile() {
  local settings="$WORKER_CONFIG_DIR/settings.json"
  [[ -f "$settings" ]] || \
    fail_config "worker profile is missing: $settings. Run apply.sh from guisaliba/agents."
  python3 - "$settings" <<'PY' || fail_config "worker profile $settings has no apiKeyHelper or ANTHROPIC_BASE_URL. Run apply.sh from guisaliba/agents."
import json
import sys

data = json.load(open(sys.argv[1], encoding="utf-8"))
ok = isinstance(data, dict) and data.get("apiKeyHelper") and \
    isinstance(data.get("env"), dict) and data["env"].get("ANTHROPIC_BASE_URL")
raise SystemExit(0 if ok else 1)
PY
}

require_key() {
  "$KEY_HELPER" >/dev/null 2>&1 || \
    fail_config "the worker provider API key is not available. Run claude-worker-key to see why."
}

# The worker gets a small, explicit environment. This keeps the coordinator's
# session variables (CLAUDECODE, ANTHROPIC_*, the Pro OAuth state) out of the
# worker, so the worker cannot fall back to the Pro plan or detect nesting.
worker_environment() {
  local name
  local -a pass=(HOME USER LOGNAME PATH SHELL LANG LC_ALL LC_CTYPE TERM TMPDIR
    XDG_CONFIG_HOME XDG_DATA_HOME XDG_STATE_HOME XDG_CACHE_HOME XDG_RUNTIME_DIR)
  WORKER_ENV=()
  for name in "${pass[@]}"; do
    if [[ -n "${!name:-}" ]]; then
      WORKER_ENV+=("$name=${!name}")
    fi
  done
  WORKER_ENV+=("CLAUDE_CONFIG_DIR=$WORKER_CONFIG_DIR")
}

command_run() {
  local alias="" dir="" brief="" report="" readonly=false
  local max_turns="$DEFAULT_MAX_TURNS" timeout_seconds="$DEFAULT_TIMEOUT"
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --model) alias="${2:-}"; shift 2 ;;
      --dir) dir="${2:-}"; shift 2 ;;
      --brief) brief="${2:-}"; shift 2 ;;
      --report) report="${2:-}"; shift 2 ;;
      --readonly) readonly=true; shift ;;
      --max-turns) max_turns="${2:-}"; shift 2 ;;
      --timeout) timeout_seconds="${2:-}"; shift 2 ;;
      *) fail_usage "unknown option for run: $1" ;;
    esac
  done

  [[ -n "$alias" && -n "$dir" && -n "$brief" && -n "$report" ]] || \
    fail_usage "run needs --model, --dir, --brief, and --report"
  [[ "$max_turns" =~ ^[1-9][0-9]*$ ]] || fail_usage "--max-turns must be a positive integer"
  [[ "$timeout_seconds" =~ ^[1-9][0-9]*$ ]] || fail_usage "--timeout must be a positive integer"
  [[ -d "$dir" ]] || fail_usage "--dir is not a directory: $dir"
  [[ -s "$brief" ]] || fail_usage "--brief is missing or empty: $brief"
  [[ -d "$(dirname -- "$report")" ]] || fail_usage "--report directory does not exist: $(dirname -- "$report")"

  local resolved model_id family
  resolved="$(resolve_alias "$alias")" || \
    fail_usage "unknown worker alias: $alias. Run: claude-worker models"
  IFS=$'\t' read -r model_id family <<<"$resolved"

  require_profile
  require_key

  local claude
  claude="$(claude_binary)" || fail_config "the claude executable is not on PATH"

  local -a arguments=(-p --model "$model_id" --output-format json
    --max-turns "$max_turns" --permission-prompts none
    --disallowedTools "$DISALLOWED_TOOLS")
  local mode
  if [[ "$readonly" == true ]]; then
    mode="readonly"
    arguments+=(--permission-mode dontAsk --allowedTools "$READONLY_TOOLS")
  else
    mode="write"
    arguments+=(--permission-mode acceptEdits --allowedTools "$WRITE_TOOLS")
  fi

  local -a timeout_prefix=()
  if command -v timeout >/dev/null 2>&1; then
    timeout_prefix=(timeout --kill-after=30 "$timeout_seconds")
  fi

  worker_environment
  local raw="$report.raw.json" errors="$report.stderr.log" started ended status=0
  started="$(date +%s)"
  (
    cd -- "$dir"
    env -i "${WORKER_ENV[@]}" "${timeout_prefix[@]}" "$claude" "${arguments[@]}" \
      <"$brief" >"$raw" 2>"$errors"
  ) || status=$?
  ended="$(date +%s)"

  mkdir -p "$STATE_DIR"
  python3 - "$raw" "$report" "$alias" "$model_id" "$family" "$mode" "$status" \
    "$started" "$ended" "$dir" "$LEDGER" <<'PY'
import json
import sys
from datetime import datetime, timezone
from pathlib import Path

(raw, report, alias, model_id, family, mode, status,
 started, ended, directory, ledger) = sys.argv[1:]
status = int(status)
payload = {}
try:
    text = Path(raw).read_text(encoding="utf-8").strip()
    if text:
        payload = json.loads(text.splitlines()[-1])
except (OSError, json.JSONDecodeError):
    payload = {}
if not isinstance(payload, dict):
    payload = {}

result = payload.get("result")
is_error = bool(payload.get("is_error")) if payload else True
usage = payload.get("usage") if isinstance(payload.get("usage"), dict) else {}
succeeded = status == 0 and not is_error and isinstance(result, str) and result.strip() != ""

report_path = Path(report)
if isinstance(result, str) and result.strip():
    report_path.write_text(result.rstrip() + "\n", encoding="utf-8")
else:
    report_path.write_text(
        "**Result**: worker produced no report.\n\n"
        f"Exit status {status}. See {raw} and {report}.stderr.log.\n",
        encoding="utf-8",
    )

meta = {
    "alias": alias,
    "model_id": model_id,
    "family": family,
    "mode": mode,
    "exit_status": status,
    "succeeded": succeeded,
    "is_error": is_error,
    "duration_seconds": int(ended) - int(started),
    "num_turns": payload.get("num_turns"),
    "usage": usage,
    "session_id": payload.get("session_id"),
    "directory": directory,
}
Path(report + ".meta.json").write_text(json.dumps(meta, indent=2) + "\n", encoding="utf-8")

ledger_path = Path(ledger)
header = "utc\talias\tmodel_id\tmode\tsucceeded\tduration_s\tturns\tinput_tokens\toutput_tokens\tcache_read_tokens\tcache_creation_tokens\tdirectory\n"
new_file = not ledger_path.exists()
with ledger_path.open("a", encoding="utf-8") as handle:
    if new_file:
        handle.write(header)
    row = [
        datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"),
        alias, model_id, mode, "yes" if succeeded else "no",
        str(meta["duration_seconds"]), str(meta["num_turns"] or 0),
        str(usage.get("input_tokens", 0)), str(usage.get("output_tokens", 0)),
        str(usage.get("cache_read_input_tokens", 0)),
        str(usage.get("cache_creation_input_tokens", 0)),
        directory.replace("\t", " "),
    ]
    handle.write("\t".join(row) + "\n")

raise SystemExit(0 if succeeded else 1)
PY
}

command_models() {
  printf 'provider: %s\n' "$(provider_setting WORKER_PROVIDER || printf unknown)"
  printf 'ALIAS\tMODEL_ID\tFAMILY\tMONTHLY_ALLOWANCE_USD\n'
  grep -v '^#' "$ROSTER" | grep -v '^[[:space:]]*$' | sed 's/^/worker\//'
}

command_doctor() {
  local live=false failures=0 claude version
  [[ "${1:-}" == "--live" ]] && live=true

  check() {
    if "$@"; then printf 'ok    %s\n' "$DOCTOR_LABEL"; else printf 'FAIL  %s\n' "$DOCTOR_LABEL"; failures=$((failures + 1)); fi
  }

  DOCTOR_LABEL="claude executable on PATH"
  check claude_binary >/dev/null
  if claude="$(claude_binary)"; then
    version="$("$claude" --version 2>/dev/null || true)"
    DOCTOR_LABEL="claude version $version is $CLAUDE_MIN_VERSION or newer"
    check python3 - "$version" "$CLAUDE_MIN_VERSION" <<'PY'
import re
import sys
found = re.search(r"(\d+)\.(\d+)\.(\d+)", sys.argv[1])
need = tuple(map(int, sys.argv[2].split(".")))
raise SystemExit(0 if found and tuple(map(int, found.groups())) >= need else 1)
PY
  fi

  DOCTOR_LABEL="worker profile $WORKER_CONFIG_DIR/settings.json"
  check bash -c '"$0" __profile' "$script_path"
  DOCTOR_LABEL="provider API key available through claude-worker-key (value not shown)"
  check "$KEY_HELPER" >/dev/null 2>&1

  DOCTOR_LABEL="every roster model id is in the provider model list"
  check models_in_live_list

  if [[ "$live" == true ]]; then
    DOCTOR_LABEL="one live worker run on worker/$(provider_setting WORKER_SMOKE_ALIAS || printf unset)"
    check live_smoke_run
  fi

  if [[ "$failures" -gt 0 ]]; then
    printf '%s check(s) failed.\n' "$failures"
    return 1
  fi
  printf 'All checks passed.\n'
}

models_in_live_list() {
  local key listing models_url
  models_url="$(provider_setting WORKER_MODELS_URL)" || return 1
  key="$("$KEY_HELPER" 2>/dev/null)" || return 1
  # The key goes to curl on standard input, so it never appears in argv.
  listing="$(printf 'header = "Authorization: Bearer %s"\n' "$key" | \
    curl --fail --silent --show-error --max-time 30 --config - "$models_url")" || return 1
  unset key
  python3 - "$ROSTER" "$listing" <<'PY'
import json
import sys
from pathlib import Path

listing = json.loads(sys.argv[2])
items = listing.get("data", listing) if isinstance(listing, dict) else listing
live = {item.get("id") for item in items if isinstance(item, dict)}
missing = []
for line in Path(sys.argv[1]).read_text(encoding="utf-8").splitlines():
    if line.strip() and not line.startswith("#"):
        model_id = line.split("\t")[1]
        if model_id not in live:
            missing.append(model_id)
if missing:
    print("  missing ids: " + ", ".join(missing), file=sys.stderr)
    print("  live ids: " + ", ".join(sorted(i for i in live if i)), file=sys.stderr)
    raise SystemExit(1)
PY
}

live_smoke_run() {
  local work smoke_alias
  smoke_alias="$(provider_setting WORKER_SMOKE_ALIAS)" || return 1
  work="$(mktemp -d)" || return 1
  printf '%s\n' 'Reply with the single word READY and nothing else.' >"$work/brief.md"
  if "$script_path" run --model "worker/$smoke_alias" --dir "$work" \
    --brief "$work/brief.md" --report "$work/report.md" --readonly --max-turns 2 --timeout 180 \
    && grep -q 'READY' "$work/report.md"; then
    rm -rf "$work"
    return 0
  fi
  printf '  smoke run artifacts kept in %s\n' "$work" >&2
  return 1
}

command_usage() {
  [[ -f "$LEDGER" ]] || { printf 'No worker runs recorded yet (%s).\n' "$LEDGER"; return 0; }
  python3 - "$LEDGER" <<'PY'
import csv
import sys
from collections import defaultdict

totals = defaultdict(lambda: [0, 0, 0, 0, 0])
with open(sys.argv[1], encoding="utf-8") as handle:
    for row in csv.DictReader(handle, delimiter="\t"):
        entry = totals[row["alias"]]
        entry[0] += 1
        entry[1] += row["succeeded"] != "yes"
        entry[2] += int(row["input_tokens"] or 0)
        entry[3] += int(row["output_tokens"] or 0)
        entry[4] += int(row["cache_read_tokens"] or 0)
print("ALIAS\tRUNS\tFAILED\tINPUT_TOKENS\tOUTPUT_TOKENS\tCACHE_READ_TOKENS")
for alias, (runs, failed, inp, out, cache) in sorted(totals.items()):
    print(f"{alias}\t{runs}\t{failed}\t{inp}\t{out}\t{cache}")
PY
}

case "${1:-}" in
  run) shift; command_run "$@" ;;
  models) command_models ;;
  doctor) shift; command_doctor "$@" ;;
  usage) command_usage ;;
  __profile) (require_profile) ;;
  -h|--help|help) usage; exit 0 ;;
  *) fail_usage "unknown command: ${1:-<none>}" ;;
esac
