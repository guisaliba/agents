#!/usr/bin/env bash
# go-key
#
# Claude Code apiKeyHelper for the OpenCode Go worker profile.
# Prints the OpenCode Go API key and nothing else, as apiKeyHelper requires.
# The key has one home on each host: OPENCODE_API_KEY in the ai-memory
# environment file, which ai-memory also uses for its LLM jobs.
set -Eeuo pipefail

script_path="$(readlink -f -- "${BASH_SOURCE[0]}" 2>/dev/null || python3 -c 'import os,sys; print(os.path.realpath(sys.argv[1]))' "${BASH_SOURCE[0]}")"
repo_dir="$(cd -- "$(dirname -- "$script_path")/.." && pwd)"
env_file="${AGENTS_GO_KEY_ENV_FILE:-$HOME/.config/ai-memory/env}"

if [[ ! -f "$env_file" ]]; then
  printf 'go-key: missing %s. Add OPENCODE_API_KEY there, then retry.\n' "$env_file" >&2
  exit 1
fi

if ! key="$(python3 "$repo_dir/lib/agent_stack.py" env-value "$env_file" OPENCODE_API_KEY 2>/dev/null)" || [[ -z "$key" ]]; then
  printf 'go-key: OPENCODE_API_KEY is not set in %s.\n' "$env_file" >&2
  exit 1
fi

printf '%s\n' "$key"
