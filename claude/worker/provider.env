# Model provider for pstack workers.
# To change provider, edit this file and models.tsv, then run ./apply.sh again.
# claude-worker, claude-worker-key, and apply.sh read these values.
WORKER_PROVIDER=opencode-go
# Anthropic Messages API compatible base URL of the provider.
WORKER_ANTHROPIC_BASE_URL=https://opencode.ai/inference/go/anthropic
# Model list endpoint that `claude-worker doctor` checks the roster against.
WORKER_MODELS_URL=https://opencode.ai/inference/go/v1/models
# Provider model id for Claude Code background tasks (the haiku slot) in workers.
WORKER_BACKGROUND_MODEL=deepseek-v4.1-flash
# Roster alias that `claude-worker doctor --live` runs once.
WORKER_SMOKE_ALIAS=deepseek-v4.1-flash
# File and variable that hold the provider API key. ~ means $HOME.
WORKER_API_KEY_ENV_FILE=~/.config/ai-memory/env
WORKER_API_KEY_VARIABLE=OPENCODE_API_KEY
